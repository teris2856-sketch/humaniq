rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // User profile + chats, mood_checks, body_checks, etc. under users/{uid}/...
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isStaff()
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function communityPublicFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['helpfulBy', 'replyCount']);
    }

    // Shared recovery community — any signed-in user can read and post.
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.text is string;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || communityPublicFieldsUnchanged()
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /community_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isStaff();
    }

    match /community_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /community_notifications/{userId}/items/{itemId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid;
    }

    match /community_saves/{postId}/users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
